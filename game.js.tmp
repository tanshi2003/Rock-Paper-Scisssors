
(() => {
  'use strict';
  const moves=['rock','paper','scissors'];
  const display={rock:'Rock',paper:'Paper',scissors:'Scissors'};
  const images={rock:'fist.png',paper:'peace.png',scissors:'scissors.png'};
  const el=id=>document.getElementById(id);
  const game={mode:'',names:['You','Computer'],score:[0,0],round:1,friendTurn:0,picks:[],finished:false,sound:true};
  let context=null,toastTimer;
  function toast(message){el('toast').textContent=message;el('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el('toast').classList.remove('show'),2100);}
  function tone(freq=440,duration=.08){if(!game.sound)return;try{context ||= new(window.AudioContext||window.webkitAudioContext)();if(context.state==='suspended')context.resume();const osc=context.createOscillator(),gain=context.createGain();osc.frequency.value=freq;gain.gain.setValueAtTime(.055,context.currentTime);gain.gain.exponentialRampToValueAtTime(.001,context.currentTime+duration);osc.connect(gain);gain.connect(context.destination);osc.start();osc.stop(context.currentTime+duration);}catch(e){/* audio is optional */}}
  function screen(isGame){el('home').classList.toggle('hidden',isGame);el('game').classList.toggle('hidden',!isGame);}
  function safeName(value,fallback){return value.trim().replace(/\s+/g,' ').slice(0,20)||fallback;}
  function esc(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
  document.querySelectorAll('[data-mode]').forEach(btn=>btn.addEventListener('click',()=>{game.mode=btn.dataset.mode;el('name-form').classList.remove('hidden');el('cpu-fields').classList.toggle('hidden',game.mode!=='cpu');el('friend-fields').classList.toggle('hidden',game.mode!=='friend');el('start').textContent=game.mode==='cpu'?'Start game':'Start match';(game.mode==='cpu'?el('name-cpu'):el('name-a')).focus();}));
  el('start').addEventListener('click',()=>{if(game.mode==='cpu'){game.names=[safeName(el('name-cpu').value,'You'),'Computer'];}else{const a=safeName(el('name-a').value,'Player 1'),b=safeName(el('name-b').value,'Player 2');if(a.toLowerCase()===b.toLowerCase()){toast('Players need different names.');return;}game.names=[a,b];}game.score=[0,0];game.round=1;game.friendTurn=0;el('mode-label').textContent=game.mode==='cpu'?'SOLO PLAY':'TWO PLAYERS';el('hint').textContent=game.mode==='cpu'?'Keyboard shortcuts: 1 Rock · 2 Paper · 3 Scissors':'Choices stay hidden until both players have picked.';updateScores();newRound();screen(true);});
  function updateScores(){el('score-name-a').textContent=game.names[0];el('score-name-b').textContent=game.names[1];el('score-a').textContent=game.score[0];el('score-b').textContent=game.score[1];}
  function newRound(){game.picks=[];game.finished=false;game.friendTurn=0;el('round-note').textContent='Round '+game.round+' · Choose your move';el('banner').textContent=game.mode==='cpu'?game.names[0]+', choose your move':game.names[0]+', choose first';el('moves').classList.remove('hidden');el('result').classList.add('hidden');el('moves').querySelectorAll('button').forEach(b=>b.disabled=false);}
  function resultIndex(a,b){if(a===b)return -1;if((a==='rock'&&b==='scissors')||(a==='paper'&&b==='rock')||(a==='scissors'&&b==='paper'))return 0;return 1;}
  function choose(move){if(game.finished||!moves.includes(move))return;tone(420,.055);if(game.mode==='cpu'){game.picks=[move,moves[Math.floor(Math.random()*3)]];finish();return;}if(game.friendTurn===0){game.picks[0]=move;game.friendTurn=1;el('moves').classList.add('hidden');el('result').classList.remove('hidden');el('pick-a').innerHTML='<strong>Choice locked</strong><span>Hidden from Player 2</span>';el('pick-b').innerHTML='<strong>Pass device</strong><span>Ready for '+esc(game.names[1])+'?</span>';el('outcome').textContent='Pass to '+game.names[1];el('outcome').className='outcome';el('next').textContent='Reveal Player 2 turn';el('banner').textContent='First choice locked';el('round-note').textContent='Pass the device to the next player';}else{game.picks[1]=move;finish();}}
  function finish(){game.finished=true;const win=resultIndex(...game.picks);if(win!==-1)game.score[win]++;updateScores();const [a,b]=game.picks;el('pick-a').innerHTML='<img src="'+images[a]+'" alt="'+display[a]+'"><strong>'+esc(game.names[0])+'</strong><span>'+display[a]+'</span>';el('pick-b').innerHTML='<img src="'+images[b]+'" alt="'+display[b]+'"><strong>'+esc(game.names[1])+'</strong><span>'+display[b]+'</span>';el('outcome').textContent=win===-1?'Draw round':game.names[win]+' wins this round';el('outcome').className='outcome '+(win===-1?'draw':win===0?'win':'loss');el('banner').textContent=win===-1?'A draw. Again?':game.names[win]+' takes this round';el('round-note').textContent='Round '+game.round+' complete';el('moves').classList.add('hidden');el('result').classList.remove('hidden');el('next').textContent='Play next round';tone(win===-1?340:620,.16);}
  el('moves').addEventListener('click',e=>{const b=e.target.closest('[data-move]');if(b&&!b.disabled)choose(b.dataset.move);});
  el('next').addEventListener('click',()=>{if(game.mode==='friend'&&game.friendTurn===1&&!game.finished){el('result').classList.add('hidden');el('moves').classList.remove('hidden');el('banner').textContent=game.names[1]+', choose your move';el('round-note').textContent='Player 2 turn';el('hint').textContent='Only Player 2 should be looking now.';return;}game.round++;newRound();});
  el('menu').addEventListener('click',()=>screen(false));el('sound').addEventListener('click',()=>{game.sound=!game.sound;el('sound').textContent='Sound: '+(game.sound?'on':'off');el('sound').setAttribute('aria-pressed',String(game.sound));if(game.sound)tone(500,.07);});
  document.addEventListener('keydown',e=>{if(el('game').classList.contains('hidden')||e.target.matches('input'))return;if(['1','2','3'].includes(e.key))choose(moves[Number(e.key)-1]);if(e.key==='Escape')screen(false);});
})();
